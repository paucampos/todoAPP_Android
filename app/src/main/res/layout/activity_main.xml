<LinearLayout android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mis tareas"
        android:textSize="26sp"
        android:textStyle="bold"
        android:padding="20dp" />

    <LinearLayout
        android:id="@+id/contenedorSinTareas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgSinTareas"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/ic_empty" />

        <TextView
            android:id="@+id/tvSinTareas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay tareas registradas"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Presiona el botón + para agregar una nueva tarea"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTareas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="20dp" />

    <!-- BARRA ABAJO -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/background"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/navInicio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgInicio"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_home" />

            <TextView
                android:id="@+id/tvInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textSize="12sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/navAgregar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foregroundGravity="center">

            <ImageButton
                android:id="@+id/btnNuevaTarea"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:backgroundTint="#00FFFFFF"
                android:contentDescription="Agregar nueva tarea"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mas" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/navTareas"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgTareas"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_tareas" />

            <TextView
                android:id="@+id/tvTareas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tareas"
                android:textSize="12sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>